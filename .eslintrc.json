{
  "env": {
    "browser": false,
    "es6": true,
    "node": true
  },
  "extends": [
    "airbnb-base",
    "airbnb-typescript/base"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "settings": {
    "import/resolver": {
      "eslint-import-resolver-custom-alias": {
        "alias": {
          "@": "./src"
        },
        "extensions": [
          ".ts"
        ]
      }
    }
  },
  "rules": {
    "import/no-restricted-paths": ["error", {
      "zones": [
        {
          "target": "./src/utils",
          "from": ["./src/config.ts", "./src/bot", "./src/service", "./src/memory", "./src/tools", "./src/chat", "./src/tasks", "./src/panel"],
          "message": "utils 应保持零业务依赖"
        },
        {
          "target": ["./src/config.ts", "./src/bot"],
          "from": ["./src/service", "./src/memory", "./src/tools", "./src/chat", "./src/tasks", "./src/panel"],
          "message": "底层 config / bot 不要反向依赖上层服务或业务"
        },
        {
          "target": "./src/service",
          "from": ["./src/bot", "./src/memory", "./src/tools", "./src/chat", "./src/tasks", "./src/panel"],
          "message": "service 层只从 @/config 获取配置，不要依赖 bot 或业务层"
        },
        {
          "target": ["./src/memory", "./src/tools"],
          "from": ["./src/chat", "./src/tasks", "./src/panel"],
          "message": "memory / tools 层不要反向依赖 chat / tasks / panel"
        },
        {
          "target": "./src/chat",
          "from": ["./src/tasks", "./src/panel"],
          "message": "chat 层不要依赖 tasks / panel"
        }
      ]
    }],
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/no-use-before-define": "off",
    "@typescript-eslint/naming-convention": "off",
    "import/prefer-default-export": "off",
    "no-use-before-define": "off",
    "camelcase": "off",
    "max-len": "off",
    "class-methods-use-this": "off",
    "radix": "off",
    "prefer-spread": "off",
    "consistent-return": "off",
    "no-restricted-syntax": "off",
    "no-await-in-loop": "off",
    "no-nested-ternary": "off",
    "linebreak-style": "off",
    "no-multiple-empty-lines": "off",
    "no-console": "off",
    "no-plusplus": "off"
  }
}
